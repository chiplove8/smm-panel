{
  "name": "smm-panel",
  "version": "1.0.0",
  "description": "SMM Panel - Express + EJS + Tailwind CSS + SQLite",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "npm run build:css && node --watch app.js",
    "test": "NODE_ENV=test DB_PATH=:memory: node --test",
    "build:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o public/css/app.css --watch"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@parcel/watcher@2.5.1": true
  }
}
