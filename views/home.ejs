<section class="bg-gradient-to-b from-indigo-50 to-slate-50">
  <div class="mx-auto max-w-6xl px-2 py-10 text-center sm:px-4 sm:py-20">
    <span class="badge bg-indigo-100 text-indigo-700">Tự động 24/7 &middot; Giá từ 900đ/1000</span>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">Tăng tương tác mạng xã hội<br class="hidden sm:block"> nhanh, rẻ, an toàn</h1>
    <p class="mx-auto mt-3 max-w-2xl text-slate-600 sm:text-lg">Like, follow, view, subscribe cho Facebook, TikTok, Instagram, YouTube, Telegram. Đặt đơn trong vài giây, theo dõi tiến độ theo thời gian thực.</p>
    <div class="mt-6 flex flex-col justify-center gap-2 sm:flex-row">
      <a href="/register" class="btn-primary px-6 py-3 text-base">Đăng ký miễn phí</a>
      <a href="/services" class="btn-secondary px-6 py-3 text-base">Xem bảng giá</a>
    </div>
    <div class="mx-auto mt-8 grid max-w-xl grid-cols-3 gap-2">
      <div class="card"><div class="text-xl font-bold text-indigo-600 sm:text-2xl"><%= formatNumber(stats.services) %></div><div class="text-xs text-slate-500 sm:text-sm">Dịch vụ</div></div>
      <div class="card"><div class="text-xl font-bold text-indigo-600 sm:text-2xl"><%= formatNumber(stats.users) %></div><div class="text-xs text-slate-500 sm:text-sm">Thành viên</div></div>
      <div class="card"><div class="text-xl font-bold text-indigo-600 sm:text-2xl"><%= formatNumber(stats.orders) %></div><div class="text-xs text-slate-500 sm:text-sm">Đơn hàng</div></div>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-2 py-8 sm:px-4 sm:py-14">
  <h2 class="text-center text-2xl font-bold text-slate-900">Vì sao chọn chúng tôi?</h2>
  <div class="mt-6 grid gap-2 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
    <% [
      ['Giá rẻ nhất', 'Giá gốc từ nhà cung cấp, càng mua nhiều càng rẻ.'],
      ['Tự động 100%', 'Đơn hàng được xử lý ngay sau khi thanh toán.'],
      ['Bảo hành', 'Nhiều dịch vụ được bảo hành tụt từ 30-60 ngày.'],
      ['Hoàn tiền', 'Tự động hoàn tiền khi đơn bị hủy hoặc chạy thiếu.'],
    ].forEach(([t, d]) => { %>
      <div class="card"><h3 class="font-semibold text-slate-900"><%= t %></h3><p class="mt-1 text-sm text-slate-600"><%= d %></p></div>
    <% }) %>
  </div>
</section>

<section class="mx-auto max-w-6xl px-2 pb-8 sm:px-4 sm:pb-14">
  <h2 class="text-center text-2xl font-bold text-slate-900">Nền tảng hỗ trợ</h2>
  <div class="mt-4 flex flex-wrap justify-center gap-2">
    <% platforms.forEach((p) => { %><span class="badge bg-white px-3 py-1 text-sm capitalize text-slate-700 ring-1 ring-slate-200"><%= p %></span><% }) %>
  </div>
  <div class="mt-6 grid gap-2 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3">
    <% featured.forEach((s) => { %>
      <div class="card flex flex-col">
        <div class="text-xs text-slate-500"><%= s.category_name %></div>
        <div class="mt-1 font-medium text-slate-900"><%= s.name %></div>
        <div class="mt-auto flex items-end justify-between pt-3">
          <div><span class="text-lg font-bold text-indigo-600"><%= formatVnd(s.rate) %></span><span class="text-xs text-slate-500"> /1000</span></div>
          <a href="/dashboard?service=<%= s.id %>" class="text-sm font-semibold text-indigo-600 hover:underline">Đặt ngay &rarr;</a>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section class="mx-auto max-w-6xl px-2 pb-10 sm:px-4 sm:pb-16">
  <div class="rounded-xl bg-indigo-600 px-4 py-8 text-center text-white sm:px-8">
    <h2 class="text-2xl font-bold">Bắt đầu chỉ trong 1 phút</h2>
    <p class="mt-1 text-indigo-100">Đăng ký &rarr; Nạp tiền &rarr; Đặt đơn. Đơn giản vậy thôi.</p>
    <a href="/register" class="btn mt-4 bg-white text-indigo-700 hover:bg-indigo-50">Tạo tài khoản</a>
  </div>
</section>
