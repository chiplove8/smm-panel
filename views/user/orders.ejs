<form method="GET" action="/orders" class="card mb-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
  <input type="search" name="q" value="<%= search %>" class="input col-span-2" placeholder="Tìm theo ID hoặc link">
  <select name="status" class="input" data-autosubmit>
    <option value="">Tất cả trạng thái</option>
    <% Object.entries(ORDER_STATUSES).forEach(([key, s]) => { %><option value="<%= key %>" <%= status === key ? 'selected' : '' %>><%= s.label %></option><% }) %>
  </select>
  <button type="submit" class="btn-secondary">Lọc</button>
</form>

<div class="card !p-0">
  <% if (!orders.length) { %>
    <p class="px-3 py-10 text-center text-sm text-slate-500">Không có đơn hàng nào. <a href="/dashboard" class="font-medium text-indigo-600">Đặt đơn ngay</a></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>ID</th><th>Thời gian</th><th>Dịch vụ / Link</th><th>Số lượng</th><th>Bắt đầu</th><th>Còn lại</th><th>Giá</th><th>Trạng thái</th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          <% orders.forEach((o) => { %>
            <tr>
              <td class="text-slate-500"><%= o.id %></td>
              <td class="whitespace-nowrap text-xs"><%= formatDate(o.created_at) %></td>
              <td class="max-w-xs"><div class="font-medium text-slate-900"><%= o.service_name %></div><a href="<%= o.link %>" target="_blank" rel="noopener noreferrer nofollow" class="block truncate text-xs text-indigo-600"><%= o.link %></a></td>
              <td><%= formatNumber(o.quantity) %></td>
              <td><%= o.start_count ?? '-' %></td>
              <td><%= o.remains ?? '-' %></td>
              <td class="whitespace-nowrap"><%= formatVnd(o.charge) %></td>
              <td><span class="badge <%= ORDER_STATUSES[o.status].badge %>"><%= ORDER_STATUSES[o.status].label %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <ul class="divide-y divide-slate-100 md:hidden">
      <% orders.forEach((o) => { %><%- include('../partials/order-row', { o }) %><% }) %>
    </ul>
  <% } %>
</div>

<% if (pages > 1) { const qs = (p) => new URLSearchParams({ ...(status ? { status } : {}), ...(search ? { q: search } : {}), page: p }).toString(); %>
  <nav class="mt-3 flex items-center justify-between text-sm">
    <span class="text-slate-500">Trang <%= page %>/<%= pages %> &middot; <%= count %> đơn</span>
    <div class="flex gap-2">
      <% if (page > 1) { %><a href="/orders?<%= qs(page - 1) %>" class="btn-secondary !px-3 !py-1">&larr; Trước</a><% } %>
      <% if (page < pages) { %><a href="/orders?<%= qs(page + 1) %>" class="btn-secondary !px-3 !py-1">Sau &rarr;</a><% } %>
    </div>
  </nav>
<% } %>
