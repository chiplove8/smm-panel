<h1>Danh sách công việc</h1>

<form action="/todos" method="POST" class="todo-form">
  <input type="text" name="text" placeholder="Thêm công việc mới..." autocomplete="off">
  <button type="submit" class="btn">Thêm</button>
</form>
<% if (error) { %>
  <p class="error"><%= error %></p>
<% } %>

<% if (todos.length === 0) { %>
  <p class="muted">Chưa có công việc nào.</p>
<% } else { %>
  <ul class="todo-list">
    <% todos.forEach((todo) => { %>
      <li class="<%= todo.done ? 'done' : '' %>">
        <form action="/todos/<%= todo.id %>/toggle" method="POST">
          <button type="submit" class="check" title="Đổi trạng thái"><%= todo.done ? '✔' : '' %></button>
        </form>
        <span class="text"><%= todo.text %></span>
        <form action="/todos/<%= todo.id %>/delete" method="POST" class="delete-form">
          <button type="submit" class="btn-delete" title="Xóa">✕</button>
        </form>
      </li>
    <% }) %>
  </ul>
<% } %>
