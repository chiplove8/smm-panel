<!DOCTYPE html>
<html lang="vi" class="bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SMM Panel</title>
  <meta name="description" content="SMM Panel - dịch vụ tăng like, follow, view cho Facebook, TikTok, Instagram, YouTube, Telegram giá rẻ, tự động 24/7.">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="flex min-h-screen flex-col font-sans text-slate-800 antialiased">
  <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-2 sm:px-4">
      <a href="/" class="text-lg font-bold text-slate-900">SMM<span class="text-indigo-600">Panel</span></a>
      <nav class="hidden items-center gap-1 sm:flex">
        <a href="/services" class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900">Bảng giá</a>
        <% if (user) { %>
          <a href="/dashboard" class="btn-primary">Vào bảng điều khiển</a>
        <% } else { %>
          <a href="/login" class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900">Đăng nhập</a>
          <a href="/register" class="btn-primary">Đăng ký</a>
        <% } %>
      </nav>
      <button type="button" data-menu-toggle class="p-1 text-slate-600 sm:hidden" aria-label="Menu"><%- include('../partials/icon', { name: 'menu', cls: 'size-6' }) %></button>
    </div>
    <div id="public-menu" class="hidden border-t border-slate-200 px-2 py-2 sm:hidden">
      <a href="/services" class="block rounded-md px-2 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Bảng giá</a>
      <% if (user) { %>
        <a href="/dashboard" class="block rounded-md px-2 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Bảng điều khiển</a>
      <% } else { %>
        <a href="/login" class="block rounded-md px-2 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100">Đăng nhập</a>
        <a href="/register" class="block rounded-md px-2 py-2 text-sm font-medium text-indigo-600 hover:bg-slate-100">Đăng ký</a>
      <% } %>
    </div>
  </header>
  <main class="flex-1">
    <%- body %>
  </main>
  <footer class="border-t border-slate-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-2 py-4 text-sm text-slate-500 sm:flex-row sm:px-4">
      <span>&copy; <%= new Date().getFullYear() %> SMM Panel</span>
      <div class="flex gap-4">
        <a href="/services" class="hover:text-slate-700">Bảng giá</a>
        <a href="/terms" class="hover:text-slate-700">Điều khoản</a>
      </div>
    </div>
  </footer>
  <script src="/js/app.js"></script>
</body>
</html>
