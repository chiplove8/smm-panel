<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | SMM Panel</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="h-full font-sans text-slate-800 antialiased">
<%
  const userNav = [
    { href: '/dashboard', label: 'Đặt đơn mới', icon: 'cart' },
    { href: '/orders', label: 'Lịch sử đơn', icon: 'list' },
    { href: '/services', label: 'Bảng giá dịch vụ', icon: 'tag' },
    { href: '/funds', label: 'Nạp tiền', icon: 'wallet' },
    { href: '/account', label: 'Tài khoản', icon: 'user' },
  ];
  const adminNav = [
    { href: '/admin', label: 'Tổng quan', icon: 'chart' },
    { href: '/admin/orders', label: 'Đơn hàng', icon: 'list' },
    { href: '/admin/services', label: 'Dịch vụ', icon: 'cog' },
    { href: '/admin/deposits', label: 'Duyệt nạp tiền', icon: 'bank' },
    { href: '/admin/users', label: 'Thành viên', icon: 'users' },
  ];
  const isActive = (href) => href === '/admin' ? currentPath === '/admin' || currentPath === '/admin/' : currentPath === href || (href !== '/dashboard' && currentPath.startsWith(href + '/'));
%>
  <div id="sidebar-backdrop" data-sidebar-close class="fixed inset-0 z-30 hidden bg-slate-900/50 lg:hidden"></div>

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-slate-900 transition-transform lg:translate-x-0">
    <div class="flex h-14 items-center justify-between px-4">
      <a href="/dashboard" class="text-lg font-bold text-white">SMM<span class="text-indigo-400">Panel</span></a>
      <button type="button" data-sidebar-close class="text-slate-400 hover:text-white lg:hidden" aria-label="Đóng menu"><%- include('../partials/icon', { name: 'close', cls: 'size-6' }) %></button>
    </div>
    <div class="mx-3 mb-3 rounded-md bg-slate-800 px-3 py-2">
      <div class="text-xs text-slate-400">Xin chào, <span class="font-medium text-slate-200"><%= user.username %></span></div>
      <div class="text-lg font-semibold text-emerald-400"><%= formatVnd(user.balance) %></div>
    </div>
    <nav class="flex-1 space-y-1 overflow-y-auto px-3 pb-4">
      <% userNav.forEach((item) => { %>
        <a href="<%= item.href %>" class="nav-link <%= isActive(item.href) ? 'active' : '' %>"><%- include('../partials/icon', { name: item.icon }) %><%= item.label %></a>
      <% }) %>
      <% if (user.role === 'admin') { %>
        <div class="px-3 pt-4 pb-1 text-xs font-semibold tracking-wider text-slate-500 uppercase">Quản trị</div>
        <% adminNav.forEach((item) => { %>
          <a href="<%= item.href %>" class="nav-link <%= isActive(item.href) ? 'active' : '' %>"><%- include('../partials/icon', { name: item.icon }) %><%= item.label %></a>
        <% }) %>
      <% } %>
    </nav>
    <form action="/logout" method="POST" class="border-t border-slate-800 p-3">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="nav-link w-full"><%- include('../partials/icon', { name: 'logout' }) %>Đăng xuất</button>
    </form>
  </aside>

  <div class="lg:pl-64">
    <header class="sticky top-0 z-20 flex h-12 items-center justify-between gap-2 border-b border-slate-200 bg-white px-2 sm:h-14 sm:px-4 lg:px-6">
      <div class="flex min-w-0 items-center gap-2">
        <button type="button" data-sidebar-open class="-ml-1 p-1 text-slate-600 lg:hidden" aria-label="Mở menu"><%- include('../partials/icon', { name: 'menu', cls: 'size-6' }) %></button>
        <h1 class="truncate text-base font-semibold sm:text-lg"><%= title %></h1>
      </div>
      <a href="/funds" class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-sm font-semibold text-emerald-700 ring-1 ring-emerald-200 hover:bg-emerald-100"><%= formatVnd(user.balance) %></a>
    </header>
    <main class="px-2 py-3 sm:px-4 sm:py-5 lg:px-6">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
